# Copy to .streamlit/secrets.toml and fill in. secrets.toml is gitignored.

# Default connection, used by every dashboard.
[oracle]
url = "host:1521/service_name"
user = "your_username"
password = "your_password"

# Optional: a dashboard that uses a different database. The section name is
# oracle_ plus the dashboard folder name (dashboards/<name>), with dashes as underscores.
# [oracle_other_project]
# url = "otherhost:1521/other_service"
# user = "..."
# password = "..."

# Only needed if the database is older than Oracle 12.1 (error DPY-3010).
# Unzip Oracle Instant Client 19c (64 bit, Basic or Basic Light) anywhere you can write, and point here.
# Use single quotes so Windows backslashes are not treated as escapes. Put this in the [oracle] section above.
# instant_client_dir = 'C:\oracle\instantclient_19_21'
